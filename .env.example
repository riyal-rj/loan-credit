# Copy to .env for local development. Every value below is a safe, non-secret default.
# No real credential belongs in this file or in .env -- see docs/adr/0005. Actual secret values
# (Phase 9 onward) live only in OpenBao; local dev secrets (if any activity ever needs one) are
# set via FINASSIST_SECRET_<NAME> and read by EnvSecretProvider, never hard-coded.

FINASSIST_ENVIRONMENT=local
FINASSIST_SERVICE_NAME=finassist-api
FINASSIST_SERVICE_VERSION=0.1.0

FINASSIST_LOG_LEVEL=INFO
FINASSIST_LOG_FORMAT=console

FINASSIST_HTTP_HOST=0.0.0.0
FINASSIST_HTTP_PORT=8000

FINASSIST_OTEL_ENABLED=true
# Leave unset to use the console span exporter locally. Point this at the OpenTelemetry
# Collector (added Phase 8) once it exists, e.g. http://localhost:4318/v1/traces
FINASSIST_OTEL_EXPORTER_OTLP_ENDPOINT=
FINASSIST_OTEL_CONSOLE_FALLBACK=true

FINASSIST_SECRET_PROVIDER=env

FINASSIST_REQUEST_BODY_MAX_BYTES=10485760

# Local-dev-only credentials; match docker compose's postgres service. Never real secrets
# (docs/adr/0009) -- Phase 9 replaces both with OpenBao-issued dynamic credentials.
#
# `finassist_app` is a non-superuser role the application connects as -- required for row-level
# security to apply at all (PostgreSQL exempts superusers from RLS even with FORCE ROW LEVEL
# SECURITY). `finassist` (superuser, created by the postgres image's POSTGRES_USER) is reserved
# for running migrations, which need DDL privileges the app must never have.
#
# Host port is 5433, not 5432: compose.yaml maps 5433->5432 so this doesn't collide with a
# Postgres already running on your machine's default port. Services inside compose still reach
# each other at postgres:5432 over the compose network regardless of this host-side mapping.
FINASSIST_DATABASE_URL=postgresql+asyncpg://finassist_app:finassist_app@localhost:5433/finassist
FINASSIST_DATABASE_MIGRATION_URL=postgresql+asyncpg://finassist:finassist@localhost:5433/finassist
FINASSIST_DATABASE_POOL_MIN_SIZE=1
FINASSIST_DATABASE_POOL_MAX_SIZE=10
FINASSIST_DATABASE_STATEMENT_TIMEOUT_SECONDS=10.0

# Local-dev-only credentials; match docker compose's minio service. Never a real secret
# (docs/adr/0009) -- Phase 9 replaces this with OpenBao-issued dynamic credentials.
FINASSIST_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
FINASSIST_OBJECT_STORE_ACCESS_KEY=finassist
FINASSIST_OBJECT_STORE_SECRET_KEY=finassist_minio_secret
FINASSIST_OBJECT_STORE_BUCKET=finassist-documents
FINASSIST_OBJECT_STORE_USE_SSL=false
FINASSIST_OBJECT_STORE_REQUEST_TIMEOUT_SECONDS=5.0

# Dev-mode Temporal (`temporal server start-dev`, docker compose's `temporal` service, `workflow`/
# `full` profiles) -- sqlite persistence, no TLS. Never point this at a production cluster without
# also setting FINASSIST_TEMPORAL_TLS_ENABLED=true (docs/adr/0011).
FINASSIST_TEMPORAL_HOST=localhost
FINASSIST_TEMPORAL_PORT=7233
FINASSIST_TEMPORAL_NAMESPACE=default
FINASSIST_TEMPORAL_TASK_QUEUE=finassist-applications
FINASSIST_TEMPORAL_TLS_ENABLED=false
FINASSIST_TEMPORAL_HUMAN_REVIEW_SLA_SECONDS=2592000

# Dev-mode Kafka (single-broker KRaft, docker compose's `kafka` service, `events`/`full` profiles).
FINASSIST_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FINASSIST_KAFKA_APPLICATIONS_TOPIC=finassist.applications.events
FINASSIST_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
FINASSIST_KAFKA_OUTBOX_RELAY_POLL_INTERVAL_SECONDS=2.0
FINASSIST_KAFKA_OUTBOX_RELAY_BATCH_SIZE=100
FINASSIST_KAFKA_PROJECTION_CONSUMER_GROUP=applications-projection
