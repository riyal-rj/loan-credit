# Copy to .env for local development. Every value below is a safe, non-secret default.
# No real credential belongs in this file or in .env -- see docs/adr/0005. Actual secret values
# (Phase 9 onward) live only in OpenBao; local dev secrets (if any activity ever needs one) are
# set via FINASSIST_SECRET_<NAME> and read by EnvSecretProvider, never hard-coded.

FINASSIST_ENVIRONMENT=local
FINASSIST_SERVICE_NAME=finassist-api
FINASSIST_SERVICE_VERSION=0.1.0

FINASSIST_LOG_LEVEL=INFO
FINASSIST_LOG_FORMAT=console

FINASSIST_HTTP_HOST=0.0.0.0
FINASSIST_HTTP_PORT=8000

FINASSIST_OTEL_ENABLED=true
# Leave unset to use the console span exporter locally. Point this at the OpenTelemetry
# Collector (added Phase 8) once it exists, e.g. http://localhost:4318/v1/traces
FINASSIST_OTEL_EXPORTER_OTLP_ENDPOINT=
FINASSIST_OTEL_CONSOLE_FALLBACK=true

FINASSIST_SECRET_PROVIDER=env

FINASSIST_REQUEST_BODY_MAX_BYTES=10485760
